# ====================================================================
# Vinnovate IT Club — Website Change Detector Environment Configuration
# ====================================================================

# Application Info
PROJECT_NAME="Website Change Detector"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Security & Secret Keys (Change in production)
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
# Default: SQLite file in data directory
DATABASE_URL="sqlite:///./data/detector.db"
# Or PostgreSQL for distributed production deployments:
# DATABASE_URL="postgresql://detector_user:secure_password@localhost:5432/change_detector"

# Browser Automation (Playwright)
BROWSER_HEADLESS=true
# Options: "chrome", "msedge", or null for bundled Chromium
BROWSER_CHANNEL="chrome"
NAVIGATION_TIMEOUT_MS=30000
EXECUTION_TIMEOUT_MS=60000
MAX_CONCURRENT_PAGES=4

# Background Scheduler & Durable Queue
SCHEDULER_INTERVAL_SECONDS=15
MAX_JOB_RETRIES=3
RETRY_INITIAL_DELAY_SECONDS=15
RETRY_BACKOFF_FACTOR=2.0
RETRY_JITTER_MAX_SECONDS=5

# Rate Limiting & Domain Concurrency
DEFAULT_DOMAIN_MIN_INTERVAL_SECONDS=3.0
DEFAULT_DOMAIN_CONCURRENCY_LIMIT=2

# Security & SSRF Protection
ALLOW_PRIVATE_IPS_FOR_TESTS=false

# SMTP / Email Alerts (Optional)
SMTP_ENABLED=false
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_TLS=true
EMAIL_FROM="alerts@changedetector.local"
